            "url": {
              "raw": "{{baseUrl}}/api/contacts/{{contactId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contacts",
                "{{contactId}}"
              ]
            }
          }
        },
        {
          "name": "Remove all contacts",
