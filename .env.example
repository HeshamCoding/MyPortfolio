# Copy this file to ".env" (same folder) and fill in your real values.
# Never commit the real .env file to GitHub.

PORT=3000

# From MongoDB Atlas -> Connect -> Drivers. Replace <password> with your DB user's password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Portfolio?retryWrites=true&w=majority

# Any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# The account with this email is the portfolio admin (can manage contacts, projects, etc.)
ADMIN_EMAIL=you@example.com
